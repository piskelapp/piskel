{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": false,
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "paths": {
      "@/*": ["./src/js/*"]
    }
  },
  "include": ["src", "tests/unit-tests"]
}
