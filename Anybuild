# Build the web app and serve only its static output on Wasmer.
load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config", "nodestatic_serve")

config = nodestatic_config(
    schema = 1,
    sws_version = "2.38.0",
    static_dir = "dest/prod",
    node_package_manager = "npm",
    node_version = "24",
    node_install_requires_all_files = True,
    node_build_command = "npm run build",
    commands = {"install": "npm ci", "build": "npm run build"},
    npm_version = "11",
)

build = nodestatic_build(config)

nodestatic_serve(
    config,
    build,
    name = "piskel",
    build_pre = [env(PUPPETEER_SKIP_DOWNLOAD = "true", ELECTRON_SKIP_BINARY_DOWNLOAD = "1")],
)
