{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "."
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUndeclaredVariables": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noUnusedVariables": "warn"
      },
      "complexity": {
        "useLiteralKeys": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "useConst": "error",
        "noRestrictedTypes": {
          "level": "error",
          "options": {
            "types": {
              "ReturnType": "Declare the type explicitly.",
              "Parameters": "Declare the type explicitly.",
              "ConstructorParameters": "Declare the type explicitly.",
              "InstanceType": "Declare the type explicitly."
            }
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      },
      "suspicious": {
        "noWith": "error",
        "noVar": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noImportCycles": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    },
    "globals": ["$"]
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      // Vendor/third-party files — legacy CSS syntax causes parse errors
      "includes": ["src/js/lib/**", "!src/js/lib/**/*.d.ts", "src/css/bootstrap/**", "src/css/spectrum/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      // Excluded due to @@include template directives
      "includes": ["src/index.html"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    }
  ]
}
